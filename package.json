{
  "name": "bd-railway",
  "version": "1.0.0",
  "private": true,
  "description": "Bangladesh Railway ticket booking prototype - Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node database/run-sql.js database/schema.sql",
    "migrate:roles": "node database/run-sql.js database/migrations/001_add_user_roles.sql",
    "migrate:auth-sessions": "node database/run-sql.js database/migrations/002_add_auth_sessions.sql",
    "migrate:constraints": "node database/run-sql.js database/migrations/003_add_domain_constraints.sql",
    "migrate:train-schedule": "node database/run-sql.js database/migrations/004_add_train_station_schedule.sql",
    "migrate:seed-train-times": "node database/run-sql.js database/migrations/005_set_seed_train_times.sql",
    "seed": "node database/seed.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
